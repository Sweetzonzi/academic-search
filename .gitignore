# 派生数据与本地状态：删掉可重建（见 README「目录约定」）
data/
bytes/
works/

# 本机生成的演示文件、报告与构建临时目录
/output/
/reports/
/.ppt-build/

# 用户配置：唯一不可重建（见 docs/使用/配置.md）——各人一份，不进版本库
config/

# 实验：白名单——只收脚本与调研素材；样本、缓存、产物不进（见 AGENTS.md 第 8 节）
# 新增实验子目录时不需要改本文件
experiments/*/*
!experiments/*/*.py
!experiments/*/_openalex-identity/

# 运行时依赖：便携 pandoc 等外部可执行文件（下载得到，不进版本库）
vendor/

# skill bundle：root.txt 是复制安装时写入的本机仓库路径（各机不同），不进版本库
skills/*/root.txt

# Python
__pycache__/
*.pyc
.pytest_cache/

# 编辑器 / 系统
.DS_Store
Thumbs.db
.vscode/
.idea/
